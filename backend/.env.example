# Copy this file to .env and fill in real values. .env is gitignored.

DATABASE_URL=postgresql://vitalens:vitalens@localhost:5432/vitalens

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# Only set this on machines where Tesseract isn't already on PATH,
# e.g. Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Local AI (Group 4)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
